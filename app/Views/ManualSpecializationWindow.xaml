<Window x:Class="DesktopSplitter.Views.ManualSpecializationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="바탕 화면에서 모니터 제거"
        Width="660" SizeToContent="Height" Language="ko-KR" FontFamily="{DynamicResource AppFontFamily}"
        Icon="{StaticResource AppIcon}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Border BorderBrush="{DynamicResource AccentButtonBackground}" BorderThickness="2" CornerRadius="6">
        <StackPanel Margin="26,22">

            <TextBlock x:Name="HeadingText" Text="바탕 화면에서 모니터 제거"
                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock x:Name="ReasonText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Windows 설정에서 진행할 순서" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StepsText" TextWrapping="Wrap" FontSize="12.5" LineHeight="21"/>
                </StackPanel>
            </Border>

            <Border x:Name="StatusBorder" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AccentButtonBackground}" BorderThickness="1"
                    CornerRadius="4" Padding="14,10" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="OpenSettingsButton" Content="디스플레이 설정 열기"
                        Appearance="Primary" MinWidth="180" Padding="16,9"
                        Click="OpenSettings_Click"/>
                <ui:Button x:Name="CancelButton" Content="취소" Margin="10,0,0,0"
                        MinWidth="120" Padding="16,9" Click="Cancel_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
