<Window x:Class="DesktopSplitter.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="디스플레이 변경 확인"
        Width="620" Height="390" Language="ko-KR" FontFamily="{DynamicResource AppFontFamily}"
        Icon="{StaticResource AppIcon}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Border BorderBrush="{DynamicResource AccentButtonBackground}" BorderThickness="2" CornerRadius="6">
        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0" Text="이 화면 설정을 유지할까요?"
                       FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock x:Name="DetailText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                       Text="화면이 제대로 보이지 않으면 기다려 주세요. 시간이 지나면 자동으로 이전 설정으로 돌아갑니다."/>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CountdownText" Text="10"
                           FontSize="86" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{DynamicResource AccentButtonBackground}"/>
                <TextBlock x:Name="CountdownCaption" Text="초 후 자동으로 복원됩니다"
                           TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button x:Name="KeepButton" Content="이 설정 유지"
                        Appearance="Primary"
                        MinWidth="180" Padding="18,12" FontSize="15"
                        Click="Keep_Click"/>
                <ui:Button x:Name="RevertButton" Content="지금 복원"
                        Margin="16,0,0,0" MinWidth="180" Padding="18,12" FontSize="15"
                        Click="Revert_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
