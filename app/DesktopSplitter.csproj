<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Keep the portable Windows TFM: Windows 10 21H2 must not require Windows 11 APIs. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>

    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled purely for NotifyIcon (tray). -->
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>DesktopSplitter</AssemblyName>
    <RootNamespace>DesktopSplitter</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Product>DesktopSplitter</Product>
    <Company>DesktopSplitter</Company>
    <AssemblyTitle>DesktopSplitter control app</AssemblyTitle>
    <!-- WPF owns DPI awareness through the PerMonitorV2 manifest. WinForms is used only
         for NotifyIcon, so its .NET 8 and .NET 10 app-startup DPI analyzers do not apply. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf"/>
    <Resource Include="Assets\App.ico"/>
    <None Update="Assets\Fonts\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <None Update="Assets\Fonts\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools\ holds standalone diagnostic programs (separate projects). They must never be
         compiled into the shipping app. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects global usings for System.Windows.Forms/System.Drawing which
         collide with WPF types (Application, MessageBox, Point, Color, ...). The tray service
         imports those namespaces explicitly instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
