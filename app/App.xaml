<Application x:Class="DesktopSplitter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Charcoal.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFontFamily">pack://application:,,,/DesktopSplitter;component/Assets/Fonts/#NanumSquareRound Regular</FontFamily>
            <FontFamily x:Key="AppHeadingFontFamily">pack://application:,,,/DesktopSplitter;component/Assets/Fonts/#NanumSquareRound Bold</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/DesktopSplitter;component/Assets/Fonts/#NanumSquareRound Regular</FontFamily>
            <FontFamily x:Key="TextControlThemeFontFamily">pack://application:,,,/DesktopSplitter;component/Assets/Fonts/#NanumSquareRound Regular</FontFamily>
            <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/DesktopSplitter;component/Assets/App.ico"/>

            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>
            <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>
            <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="{DynamicResource AppHeadingFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
